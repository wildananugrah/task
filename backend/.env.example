# Production config for the API. Copy to backend/.env and fill in.
# infra/.env.example is the same set with local-development values.
#
# Bun reads this file from the process working directory, which is what pm2's
# `cwd` in ecosystem.config.cjs points at — nothing has to pass it through.

NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://taskspace:CHANGE_ME@localhost:5432/taskspace

# ── Ports ───────────────────────────────────────────────────────────────────
# 3004 is what deploy/nginx proxies /api/ to, and 3005 what it proxies /ws to.
API_PORT=3004
WS_PORT=3005

# ── Origins ─────────────────────────────────────────────────────────────────
# The site the SPA is served from. Its scheme decides whether the session cookie
# is marked Secure, and it is where Google sign-in returns to.
APP_ORIGIN=https://task.mhamzah.id
# Must be wss:// behind TLS, and must match the nginx /ws location.
PUBLIC_WS_URL=wss://task.mhamzah.id/ws

# ── Secrets ─────────────────────────────────────────────────────────────────
# openssl rand -hex 32   (a different value for each)
SESSION_SECRET=CHANGE_ME
# The API mints socket tickets with this and ws/ verifies them; both must agree.
WS_TICKET_SECRET=CHANGE_ME

# ── Sign-in ─────────────────────────────────────────────────────────────────
# MUST be false in production: it lets anyone sign in as any email address.
AUTH_DEV_MODE=false

# Authorised redirect URI in Google Cloud: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://task.mhamzah.id/api/auth/google/callback
# Comma-separated; empty means any Google account may sign in.
GOOGLE_ALLOWED_DOMAINS=

# ── S3 ──────────────────────────────────────────────────────────────────────
# The browser PUTs and GETs directly on presigned URLs, so the bucket needs CORS
# allowing PUT and GET with the Content-Type header from APP_ORIGIN. Without it
# uploads fail in the browser while every server-side check still passes.
# AWS: leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=taskspace
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=26214400
