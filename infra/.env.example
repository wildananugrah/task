# Copy to infra/.env (docker compose) and backend/.env + ws/.env (the services).
# One file is kept here so the three stay in step.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=taskspace
POSTGRES_PASSWORD=taskspace
POSTGRES_DB=taskspace
POSTGRES_PORT=5432
DATABASE_URL=postgres://taskspace:taskspace@localhost:5432/taskspace

# ── Services ────────────────────────────────────────────────────────────────
# 3004 is what deploy/nginx already proxies /api/ to. Keep it.
API_PORT=3004
WS_PORT=3005
APP_ORIGIN=http://localhost:5173
PUBLIC_WS_URL=ws://localhost:3005/ws

# ── Sessions ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me-0000000000000000000000000000
# Signs the 60-second socket tickets. May differ from SESSION_SECRET; both
# services must agree on this one.
WS_TICKET_SECRET=dev-ws-ticket-secret-change-me-000000000000000000000000

# Lets the login screen sign in as a seeded account when Google is not set up.
# MUST be false in production.
AUTH_DEV_MODE=true

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Authorised redirect URI: <api origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3004/api/auth/google/callback
# Comma-separated; empty means any Google account may sign in.
GOOGLE_ALLOWED_DOMAINS=

# ── S3 (third-party object storage) ─────────────────────────────────────────
# AWS:        leave S3_ENDPOINT empty, set S3_REGION
# Cloudflare: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, region auto
# MinIO:      S3_ENDPOINT=http://localhost:9000 and path style on
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=taskspace
S3_ACCESS_KEY_ID=taskspace
S3_SECRET_ACCESS_KEY=taskspace-secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAX_UPLOAD_BYTES=26214400
